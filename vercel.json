{
  "version": 2,
  "builds": [{ "src": "**/*", "use": "@vercel/static" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(?:jpg|jpeg|png|webp|avif|svg|ico|woff2|woff|ttf|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "/blog/([^/]+)", "dest": "/blog-post.html" },
    { "src": "/blog",         "dest": "/blog.html" },
    { "src": "/store",        "dest": "/store.html" },
    { "src": "/assinaturas",  "dest": "/assinaturas.html" },
    { "src": "/minha-conta",  "dest": "/minha-conta.html" },
    { "src": "/booking",      "dest": "/booking.html" },
    { "src": "/admin",        "dest": "/admin.html" },
    { "src": "/(.*)",         "dest": "/$1" }
  ]
}
