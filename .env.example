# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env

# Chave de API do Asaas (encontre em: Conta > Configurações > Integrações)
ASAAS_API_KEY=your_api_key_here

# URL base da API Asaas
# Sandbox (testes): https://sandbox.asaas.com/api/v3
# Produção:         https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Wallet ID (encontre em: Conta > Configurações > Integrações > Wallet ID)
# Sandbox: 4e0c3038-19e6-40d8-b0c5-607576336ce3
ASAAS_WALLET_ID=4e0c3038-19e6-40d8-b0c5-607576336ce3

# Porta do servidor
PORT=3001

# Origens permitidas (domínios do frontend, separados por vírgula)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://seudominio.com.br
